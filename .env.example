# ---------------------------------------------------------------------------
# jev-droid — modelo principal + decisões rápidas
# Copie para .env e preencha. NUNCA faça commit do .env.
# ---------------------------------------------------------------------------

# Obrigatório: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo principal (System Two): responsável por escolher cada ação.
# https://openrouter.ai/deepseek/deepseek-v4.1-flash-1017
JEV_DROID_MODEL=deepseek/deepseek-v4.1-flash-1017

# Modelo de decisões (System One): triagem de ecrã + guardrail de ações.
JEV_DROID_JEV_MODEL=typesafe/jev-1.13
JEV_DROID_JEV_TRIAGE=true
JEV_DROID_JEV_GUARD=true

# Limites do ciclo do agente.
JEV_DROID_MAX_STEPS=20
JEV_DROID_TEMPERATURE=0.2
JEV_DROID_STEP_DELAY_MS=800
JEV_DROID_BOOT_TIMEOUT_MS=300000

# AVD predefinido (criado por `npm run avd:setup`).
JEV_DROID_AVD=jev_google_36
# Deixe vazio para arrancar/reutilizar o AVD automaticamente.
JEV_DROID_SERIAL=
JEV_DROID_HEADLESS=true

# Artefactos (XML, PNG, JSONL, resumo) por execução.
JEV_DROID_ARTIFACTS=artifacts

# Opcional: fixar provider no OpenRouter (tag exata, ex.: deepseek).
# JEV_DROID_PROVIDER=

# Opcional: threshold de confiança para bandas JEV (0..1).
JEV_DROID_JEV_AUTO_THRESHOLD=0.9
JEV_DROID_JEV_HITL_THRESHOLD=0.5

# Android SDK. Se vazio, usa ANDROID_HOME/ANDROID_SDK_ROOT ou o caminho padrão
# %LOCALAPPDATA%\Android\Sdk no Windows.
# ANDROID_HOME=C:\Users\you\AppData\Local\Android\Sdk
# JAVA_HOME=C:\Program Files\Microsoft\jdk-21.0.13.21-hotspot
